{
	"$schema": "./node_modules/fallow/schema.json",
	// Process entry points, not import roots. `scripts/lint-edited.mjs` is the third
	// kind: nothing imports it and no npm script runs it — Claude Code spawns it per edit,
	// named in `.claude/settings.json`. Declared here rather than given a contrived npm
	// script, and `tests/build/lint-edited.test.ts` is what checks the naming still resolves.
	// `scripts/harness-shot.mjs` is the same shape from the other direction: an npm script
	// (`harness-shot`) does run it, but fallow's import graph starts from `entry` and this
	// file imports nothing under `src/` or `tests/` — nothing else in the graph reaches it
	// either, so it needs the same declaration or fallow reports it dead.
	"entry": ["src/main.ts", "tests/harness/page.ts", "scripts/lint-edited.mjs", "scripts/harness-shot.mjs"],
	"dynamicallyLoaded": ["styles/**/*.css", "tests/harness/theme.css", "tests/harness/obsidian.css"],
	// `entry` has no "dev tooling" role the way a framework plugin's `entryPointRole` does —
	// every manual entry is otherwise treated as production-reachable code, so
	// `scripts/harness-shot.mjs`'s own devDependency (`playwright-core`) reads as a
	// devDependency imported by production code, which `dev-dependencies-in-production`
	// exists to catch for a real case: an import a production-only install would break on.
	// This is the opposite — the importing file IS the dev tooling — and fallow's own
	// suggested fix for this exact finding is this key.
	"ignoreDependencies": ["playwright-core"],
	"duplicates": {
		"ignore": ["tests/harness/obsidian.css"]
	},
	// The harness page's plugin stylesheet is SERVED, not imported: the dev server answers
	// `/styles.css` from styles/ (scripts/vite-assembled-styles.mjs), so there is no file on
	// disk for a static analyser to resolve — and there must not be one, or the page could
	// show a stale build.
	"ignoreUnresolvedImports": ["/styles.css"],
	"health": {
		"coverage": "coverage/coverage-final.json",
		"ignore": ["tests/**"]
	},
	"rules": {
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-class-members": "error",
		"private-type-leaks": "warn"
	},
	// Members a FRAMEWORK invokes — declared rather than suppressed inline, which is what
	// keeps the rule able to report a genuinely dead one. A settings tab's contract is these
	// three: what it declares, what it answers for a control key, and what it does with a new
	// value. Obsidian calls all three; nothing in `src/` does.
	"usedClassMembers": [
		{ "extends": "Plugin", "members": ["onload", "onunload"] },
		{ "extends": "PluginSettingTab", "members": ["getSettingDefinitions", "getControlValue", "setControlValue"] }
	],
	"overrides": [
		{
			"files": ["tests/**"],
			"rules": { "unused-class-members": "off" }
		}
	]
}
