{
	"$schema": "./node_modules/fallow/schema.json",
	// Process entry points, not import roots. `scripts/lint-edited.mjs` is the third
	// kind: nothing imports it and no npm script runs it — Claude Code spawns it per edit,
	// named in `.claude/settings.json`. Declared here rather than given a contrived npm
	// script, and `tests/build/lint-edited.test.ts` is what checks the naming still resolves.
	// `scripts/harness-shot.mjs` is the same shape from the other direction: an npm script
	// (`harness-shot`) does run it, but fallow's import graph starts from `entry` and this
	// file imports nothing under `src/` or `tests/` — nothing else in the graph reaches it
	// either, so it needs the same declaration or fallow reports it dead.
	// `scripts/concept-shots.mjs` is the same case as `harness-shot.mjs` and needs the same
	// line, and so is `scripts/background-fixture.mjs` — an npm script runs it
	// (`background-fixture`) to redraw the PNG the manual smoke test uses as a plan
	// background, and it imports nothing under `src/` or `tests/`. `scripts/chromium.mjs` deliberately does NOT: both of them import it, so fallow
	// reaches it through the graph — and it having to be reachable is the point of it being
	// one file rather than a copy in each.
	// `tests/presentation/editor/type-safety.test-d.ts` is a fourth kind, next to
	// `scripts/lint-edited.mjs` above: nothing imports it and no npm script runs it either
	// — `vue-tsc -noEmit` type-checks it because `tsconfig.json`'s `include` names it
	// directly, and compiling is the whole point: its two `@ts-expect-error` directives have
	// to fail to compile (an unused one is a compile error) and its `SelectionStore`
	// assignability check has to succeed. The file's job is to be type-checked, never to be
	// imported or executed.
	"entry": [
		"src/main.ts",
		"tests/harness/page.ts",
		"scripts/lint-edited.mjs",
		"scripts/harness-shot.mjs",
		"scripts/concept-shots.mjs",
		"scripts/background-fixture.mjs",
		"tests/presentation/editor/type-safety.test-d.ts"
	],
	// Loaded by a page, never imported by a module — which is what this key is for.
	// `docs/user-experience/concepts/*.css` are the concept mocks' sheets: the static HTML
	// files beside them link these, and those files are documentation rather than an entry
	// point, so fallow's import graph cannot reach any of them and reports them dead.
	// Declared as the three files they are rather than as `docs/**/*.css`, so the next
	// stylesheet somebody drops into `docs/` still has to be accounted for instead of being
	// silently covered. That is not a hypothetical: `canvas.css` arrived, this list was not
	// updated, and all four CI legs went red on a change that touched nothing but `docs/`.
	// The paragraph above predicted it exactly, which is the argument FOR the named list —
	// a glob would have absorbed the new file and told nobody.
	"dynamicallyLoaded": [
		"styles/**/*.css",
		"tests/harness/theme.css",
		"tests/harness/obsidian.css",
		"docs/user-experience/concepts/concept.css",
		"docs/user-experience/concepts/page.css",
		"docs/user-experience/concepts/canvas.css"
	],
	// `entry` has no "dev tooling" role the way a framework plugin's `entryPointRole` does —
	// every manual entry is otherwise treated as production-reachable code, so
	// `scripts/harness-shot.mjs`'s own devDependency (`playwright-core`) reads as a
	// devDependency imported by production code, which `dev-dependencies-in-production`
	// exists to catch for a real case: an import a production-only install would break on.
	// This is the opposite — the importing file IS the dev tooling — and fallow's own
	// suggested fix for this exact finding is this key. `@napi-rs/canvas` is the second
	// instance of exactly that shape: `scripts/background-fixture.mjs` draws the smoke
	// test's PNG background with it, and that script is dev tooling declared as an entry.
	//
	// `konva` is `vue-konva`'s PEER dependency, and fallow's advice for it — "test-only
	// production dependency, consider moving to devDependencies" — would be wrong: a peer
	// dependency is the importing package's requirement on ITS host, so this project has to
	// declare it and ship it, while `src/` never names it (the components use `<VStage>` and
	// friends, which `vue-konva` registers). What fallow sees is the test suite importing
	// `konva` directly to inspect the scene it built, which is the only DIRECT import there
	// is. Moving it to devDependencies would produce a plugin that loads in this repository
	// and fails in a vault.
	"ignoreDependencies": ["playwright-core", "@napi-rs/canvas", "konva"],
	"duplicates": {
		"ignore": ["tests/harness/obsidian.css"]
	},
	// The harness page's plugin stylesheet is SERVED, not imported: the dev server answers
	// `/styles.css` from styles/ (scripts/vite-assembled-styles.mjs), so there is no file on
	// disk for a static analyser to resolve — and there must not be one, or the page could
	// show a stale build.
	"ignoreUnresolvedImports": ["/styles.css"],
	// One export, in one file, consumed only through a DYNAMIC import — which fallow's
	// static graph cannot follow, and the dynamic import is not a style choice: `vi.mock` is
	// hoisted above the test file's imports, and the static form fails at runtime with
	// `Cannot access '__vi_import_5__' before initialization` (measured, not assumed). Named
	// rather than globbed, so the next unused export in this helper is still a finding.
	"ignoreExports": [
		{ "file": "tests/helpers/logger.ts", "exports": ["consoleLoggerMock"] }
	],
	"health": {
		"coverage": "coverage/coverage-final.json",
		"ignore": ["tests/**"]
	},
	"rules": {
		"unused-dev-dependencies": "error",
		"unused-optional-dependencies": "error",
		"unused-class-members": "error",
		"private-type-leaks": "warn"
	},
	// Members a FRAMEWORK invokes — declared rather than suppressed inline, which is what
	// keeps the rule able to report a genuinely dead one. A settings tab's contract is these
	// three: what it declares, what it answers for a control key, and what it does with a new
	// value. Obsidian calls all three; nothing in `src/` does.
	"usedClassMembers": [
		{ "extends": "Plugin", "members": ["onload", "onunload"] },
		{ "extends": "PluginSettingTab", "members": ["getSettingDefinitions", "getControlValue", "setControlValue"] }
	],
	"overrides": [
		{
			"files": ["tests/**"],
			"rules": { "unused-class-members": "off" }
		}
	]
}
