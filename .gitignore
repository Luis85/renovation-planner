# the vault this repository is its own test vault for; `npm run test-build` writes
# the plugin into .obsidian/plugins/<id>/
.obsidian

# the build: dist/main.js and dist/styles.css (the latter assembled from styles/ by
# styles-assemble.mjs). Nothing is built into the repository root — see vite.config.ts.
dist/
*.js.map

# dependencies
node_modules/

# scripts/harness-shot.mjs's PNGs — drawn for looking at, not for diffing against.
/harness-shots/

# misc — anchored to the root: an unanchored name would also swallow a future test
# fixture of the same name anywhere in the tree, silently never staged. (.DS_Store is
# the exception on purpose; macOS drops it everywhere.) The vault's data.json needs no
# entry — `.obsidian` above already covers the only place Obsidian writes one.
.DS_Store
/coverage*/
/release-notes.md

/Renovation

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Unanchored: .impeccable may sit at the repo root or under a nested
# workspace (apps/web/.impeccable/...); anchored patterns would miss it.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# The SFC probes `tests/build/lint-edited.test.ts` plants. Its `afterEach` removes them, so
# this rule is for the run that is KILLED — a Ctrl+C or a timed-out CI leg leaves one behind,
# and `git add -A` would then commit it. That is worse than the litter it looks like: a probe
# in the tree is a real `.vue` file matching the exclusion in `tests/helpers/plantedProbe.ts`,
# so it would be permanently skipped by the harness walk AND by the lint-scope coverage check
# whose whole promise is that no source file falls out of scope — a file no gate reads.
#
# The path is the one `plantedProbePath` builds; the two are checked against each other by
# `tests/build/planted-probe.test.ts` only insofar as it pins the NAME, so a rename that
# missed this line would leak again. Anchored, because that is the one directory it plants in.
/tests/harness/lint-edited-probe-*.vue

# Python bytecode — `lookup.py` and `sections.py` in docs/reviews/ are run directly.
__pycache__/
*.pyc

# The subagent-driven-development workspace: one directory per plan, holding that plan's
# ledger, task briefs, implementer reports and review packages. Scratch by design — the
# git history is the record once a plan lands, and the ledger's own recovery value ends
# with the session. Anchored, like everything else here: the tool writes it at the repo
# root and nowhere else.
/.superpowers/

# Worktrees, one directory per branch in flight. They used to live in a SIBLING directory
# (`../renovation-planner-worktrees/`), which needed no ignore rule and was the reason to
# reconsider: a path outside the repository is invisible to `git status` here, so an
# abandoned worktree holding uncommitted work was findable only by `git worktree list`,
# and four of them accumulated before anyone looked.
#
# Inside the repository they are visible and ignored. What that costs is worth stating,
# because a worktree is a FULL COPY of `src/`, `tests/` and `styles/`: every gate that
# walks the tree could see two of every file. The leading dot plus this rule is what stops
# that, and it was measured rather than assumed — `npm run check` was run with a real
# worktree sitting in here, so the claim is that all four steps ignore it, not that they
# ought to. If a future tool starts reporting duplicate findings, this directory is the
# first place to look.
/.worktrees/
