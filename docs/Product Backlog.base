filters:
  and:
    - file.inFolder("docs")
    - file.ext == "md"
views:
  - type: product-backlog
    name: Backlog
    order:
      - file.name
      - dependsOn
      - horizon
      - iteration
      - status
    homeFolder: docs
    openIn: split
    stateProperty: note.status
    startedDateProperty: note.started
    finishedDateProperty: note.finished
    horizonProperty: note.horizon
    startProperty: note.start
    targetProperty: note.due
    riskProperty: note.risk
    priorityProperty: note.priority
    assigneeProperty: note.assignee
    dependsOnProperty: note.dependsOn
    iterationProperty: note.iteration
    iterationGoalProperty: note.goal
    inferFolderHierarchy: false
    hierarchyOnly: true
    stateValues: New, Ready, Active, Resolved, Done
    startedStates: Active
    deliverableStateValues: New, Active, Done
    iterationOpenStates: Ready
    iterationResolvedStates: Resolved
    iterationsOnTimeline: false
    testStateValues: Draft, Ready, Approved
    typeFolder.absence: docs/absences
    stateColor.ready: "#e6cb1e"
    stateColor.active: "#0e41b9"
  - type: table
    name: Business rules
    filters:
      and:
        - file.inFolder("docs/product/business-rules")
    groupBy:
      property: area
      direction: ASC
    order:
      - rule
      - file.name
      - kind
      - area
    columnSize:
      file.name: 541
  - type: table
    name: ADRs
    filters:
      and:
        - file.inFolder("docs/development/adrs")
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - status
      - area
    columnSize:
      file.name: 541
      note.status: 99
      note.area: 122
  - type: table
    name: Actors
    filters:
      and:
        - file.inFolder("docs/actors")
    groupBy:
      property: kind
      direction: ASC
    order:
      - file.name
      - standing
      - kind
      - partOf
    columnSize:
      note.standing: 150
      note.kind: 78
  - type: cards
    name: Components
    filters:
      and:
        - file.inFolder("docs/components")
    groupBy:
      property: region
      direction: ASC
    order:
      - file.name
      - region
      - slice
    columnSize:
      file.name: 220
      note.slice: 599
    image: note.image
    cardSize: 290
    imageFit: contain
  - type: table
    name: Entities
    filters:
      and:
        - file.inFolder("docs/entities")
    groupBy:
      property: layer
      direction: ASC
    order:
      - type
      - file.name
      - layer
      - persistence
      - partOf
