filters:
  and:
    - file.inFolder("docs")
    - file.ext == "md"
views:
  - type: product-backlog
    name: Backlog
    order:
      - file.name
      - dependsOn
      - horizon
      - release
      - status
    homeFolder: docs
    openIn: split
    stateProperty: note.status
    startedDateProperty: note.started
    finishedDateProperty: note.finished
    horizonProperty: note.horizon
    startProperty: note.start
    targetProperty: note.due
    riskProperty: note.risk
    priorityProperty: note.priority
    assigneeProperty: note.assignee
    dependsOnProperty: note.dependsOn
    iterationProperty: note.iteration
    iterationGoalProperty: note.goal
    inferFolderHierarchy: false
    hierarchyOnly: true
    stateValues: New, Ready, Active, Resolved, Done, Removed
    startedStates: Active
    deliverableStateValues: New, Active, Done
    iterationOpenStates: Ready
    iterationResolvedStates: Resolved
    iterationsOnTimeline: false
    testStateValues: Draft, Ready, Approved
    typeFolder.absence: docs/absences
    stateColor.ready: "#e6cb1e"
    stateColor.active: "#0e41b9"
    releaseProperty: note.release
  - type: product-release
    name: Release Management
    membershipProperty: note.release
    versionProperty: note.version
    targetDateProperty: note.target-date
    releasedDateProperty: note.released
    descriptionProperty: note.description
    releaseStatusProperty: note.status
    stateProperty: note.status
    releaseNotesFolder: docs/release-notes
    releasedStatusValues: Released
    releasedTransitionValue: Released
    releaseStatusValues: Planned, In Progress, Released
  - type: product-estimation
    name: Estimation
    dimProperty.strategic-alignment: note.strategic-alignment
    dimProperty.customer-value: note.customer-value
    dimProperty.business-impact: note.business-impact
    dimProperty.reach: note.reach
    dimProperty.risk-reduction: note.risk-reduction
    dimProperty.compliance: note.compliance
    dimProperty.time-criticality: note.time-criticality
    dimProperty.enablement: note.enablement
    confidenceProperty: note.confidence
    effortProperty: note.effort
    complexityProperty: note.complexity
    valueProperty: note.business-value
    stampProperty: note.business-value-model
    indicatorLabel: RICE
    indicatorOperands: reach, business-impact, confidence
    indicatorDivisor: effort
  - type: table
    name: Business rules
    filters:
      and:
        - file.inFolder("docs/product/business-rules")
    groupBy:
      property: area
      direction: ASC
    order:
      - rule
      - file.name
      - kind
      - area
    columnSize:
      file.name: 541
  - type: table
    name: ADRs
    filters:
      and:
        - file.inFolder("docs/development/adrs")
    groupBy:
      property: area
      direction: ASC
    order:
      - file.name
      - status
      - area
    columnSize:
      file.name: 541
      note.status: 99
      note.area: 122
  - type: table
    name: Actors
    filters:
      and:
        - file.inFolder("docs/actors")
    groupBy:
      property: kind
      direction: ASC
    order:
      - file.name
      - standing
      - kind
      - partOf
    columnSize:
      note.standing: 150
      note.kind: 78
  - type: cards
    name: Components
    filters:
      and:
        - file.inFolder("docs/components")
    groupBy:
      property: region
      direction: ASC
    order:
      - file.name
      - region
      - slice
    columnSize:
      file.name: 220
      note.slice: 599
    image: note.image
    cardSize: 290
    imageFit: contain
  - type: table
    name: Entities
    filters:
      and:
        - file.inFolder("docs/entities")
    groupBy:
      property: layer
      direction: ASC
    order:
      - type
      - file.name
      - layer
      - persistence
      - partOf
  - type: table
    name: Data Quality
    order:
      - file.name
      - horizon
      - release
    sort:
      - property: release
        direction: DESC
      - property: horizon
        direction: DESC
    columnSize:
      file.name: 447
      note.horizon: 176
