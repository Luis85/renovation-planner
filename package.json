{
	"name": "renovation-planner",
	"version": "0.1.0",
	"description": "Plan a renovation as a work breakdown of rooms, trades and tasks, with budgets and a schedule.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "tsc -noEmit -skipLibCheck && vite build",
		"test-build": "tsc -noEmit -skipLibCheck && vite build --mode development && node scripts/test-build.mjs",
		"harness": "vite --config vite.harness.config.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint --deny-warnings && eslint . --max-warnings 0",
		"analyze": "fallow",
		"audit": "npm audit --omit=dev --audit-level=critical",
		"check": "npm run build && npm run lint && npm run test:coverage && npm run analyze",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"renovation",
		"planner"
	],
	"author": "Luis85",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fallow": "^3.15.0",
		"jsdom": "^30.0.1",
		"mdast-util-from-markdown": "^2.0.3",
		"obsidian": "1.13.0",
		"oxlint": "^1.79.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22"
	}
}
