{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "allowJs": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020", "ES2021.Intl", "ES2023.Array"],
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/application/ports/diagnostics.test-d.ts",
    "tests/presentation/editor/type-safety.test-d.ts",
    "tests/harness/**/*.vue",
    "tests/helpers/makeRenovationProjectView.ts",
    "tests/helpers/fixtureVault.test-d.ts",
    "tests/presentation/errors/errorSurfacePolicy.test-d.ts"
  ]
}
